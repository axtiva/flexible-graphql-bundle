{
  "name": "axtiva/flexible-graphql-bundle",
  "description": "Schema first bundle for generate php code from graphql sdl to TypeRegistry with webonyx/graphql-php for symfony framework",
  "license": "MIT",
  "authors": [
    {
      "name": "bpteam",
      "email": "bpteam22@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Axtiva\\FlexibleGraphqlBundle\\": "src/"
    }
  },
  "require": {
    "php": "^8.3",
    "axtiva/flexible-graphql-php": "^3.0",
    "symfony/config": "^6.4 | ^7.0 | ^8.0",
    "symfony/dependency-injection": "^6.4 | ^7.0 | ^8.0",
    "symfony/framework-bundle": "^6.4 | ^7.0 | ^8.0",
    "symfony/property-access": "^6.4 | ^7.0 | ^8.0"
  },
  "require-dev": {
    "symfony/console": "^6.4 | ^7.0 | ^8.0",
    "phpunit/phpunit": "^12"
  }
}
